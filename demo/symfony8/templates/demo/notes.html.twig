{% extends 'base.html.twig' %}

{% block title %}Notes - Storage Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Notes', intro: 'Write a note and upload an image into it; the image is stored in the private bucket.'}) }}
{% endblock %}

{% block body %}
{% set upload = nowo_storage_upload('board', board) %}
{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'New note', kind: 'form', form: form, upload: upload} %}
    {% block section_body %}
        {% if upload.state == 'off' %}
            <p class="nowo-ui-muted" data-testid="demo-upload-off">Image uploads are not set up: configure a bucket in <a href="{{ path('nowo_storage_kit_settings') }}">Storage</a>.</p>
        {% endif %}
        {{ form_start(form) }}
            {% for child in form %}
                {% if not child.rendered %}{{ form_row(child) }}{% endif %}
            {% endfor %}
        {{ form_end(form) }}
        {# What an editor such as MilkdownEditorBundle receives (nowo_storage_milkdown_upload): the JSON endpoint and its token. #}
        <dl class="nowo-ui-muted" data-testid="demo-upload-config" data-state="{{ upload.state }}" data-url="{{ upload.url|default('') }}" data-token="{{ upload.token|default('') }}">
            <dt>Upload endpoint</dt><dd><code class="nowo-ui-code">{{ upload.url|default('—') }}</code> (state <code class="nowo-ui-code">{{ upload.state }}</code>)</dd>
        </dl>
    {% endblock %}
{% endembed %}

{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Notes', kind: 'list', empty: notes is empty, state_message: 'No notes yet.', testid: notes is empty ? 'demo-no-notes' : null, notes: notes} %}
    {% block section_body %}
        {% for note in notes %}
            {% set images = nowo_storage_images(note.body) %}
            <article data-testid="demo-note">
                <p>{{ note.body|u.truncate(400, '…')|nl2br }}</p>
                {% for uuid, image in images %}
                    <a href="{{ image.original }}"><img src="{{ image.src }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt }}" loading="lazy" data-testid="demo-note-image-view"></a>
                {% endfor %}
                <p class="nowo-ui-muted">{{ note.author }} · <time datetime="{{ note.createdAt|date('c') }}">{{ note.createdAt|date('Y-m-d H:i') }}</time></p>
            </article>
        {% endfor %}
    {% endblock %}
{% endembed %}
{% endblock %}
