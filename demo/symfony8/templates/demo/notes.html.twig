{% extends 'base.html.twig' %}

{% block title %}Notes - Storage Kit Demo{% endblock %}

{% block body %}
{% set upload = nowo_storage_upload('board', board) %}
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h1>New note</h1></div>
    <div class="nowo-ui-card__body">
        {% if upload.state == 'off' %}
            <p class="nowo-ui-flash nowo-ui-flash--warning" data-testid="demo-upload-off">Image uploads are not set up: configure a bucket in <a href="{{ path('nowo_storage_kit_settings') }}">Storage</a>.</p>
        {% endif %}
        {{ form_start(form) }}
            {% for child in form %}
                {% if not child.rendered %}{{ form_row(child) }}{% endif %}
            {% endfor %}
        {{ form_end(form) }}
        {# What an editor such as MilkdownEditorBundle receives (nowo_storage_milkdown_upload): the JSON endpoint and its token. #}
        <dl class="nowo-ui-muted" data-testid="demo-upload-config" data-state="{{ upload.state }}" data-url="{{ upload.url|default('') }}" data-token="{{ upload.token|default('') }}">
            <dt>Upload endpoint</dt><dd><code class="nowo-ui-code">{{ upload.url|default('—') }}</code> (state <code class="nowo-ui-code">{{ upload.state }}</code>)</dd>
        </dl>
    </div>
</div>

<h2>Notes</h2>
{% for note in notes %}
    {% set images = nowo_storage_images(note.body) %}
    <article class="nowo-ui-card" data-testid="demo-note">
        <div class="nowo-ui-card__body">
            <p style="white-space: pre-line">{{ note.body|u.truncate(400, '…') }}</p>
            <div class="demo-images">
                {% for uuid, image in images %}
                    <a href="{{ image.original }}"><img src="{{ image.src }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt }}" loading="lazy" style="max-width: 100%; height: auto" data-testid="demo-note-image-view"></a>
                {% endfor %}
            </div>
            <p class="nowo-ui-muted">{{ note.author }} · {{ note.createdAt|date('Y-m-d H:i') }}</p>
        </div>
    </article>
{% else %}
    <p class="nowo-ui-muted" data-testid="demo-no-notes">No notes yet.</p>
{% endfor %}
{% endblock %}
