{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, no token overrides). It is also the host layout of the Storage and Move
    pages and the Instance Settings sections (nowo_ui_kit.layouts.admin). The header menu lists the demo pages. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Storage Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route')|default('') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Storage Kit Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('demo_notes') }}"{% if _route == 'demo_notes' %} aria-current="page"{% endif %}>Notes</a>
            <a class="nowo-ui-link" href="{{ path('nowo_storage_kit_settings') }}"{% if _route == 'nowo_storage_kit_settings' %} aria-current="page"{% endif %}>Storage</a>
            <a class="nowo-ui-link" href="{{ path('nowo_storage_kit_move') }}"{% if _route == 'nowo_storage_kit_move' %} aria-current="page"{% endif %}>Move</a>
        </nav>
        <span class="nowo-ui-badge nowo-ui-badge--neutral">Symfony 8 · FrankenPHP</span>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit visible-when peer (provider-dependent fields): demo Stimulus app; a real host registers the peer in its own app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
{% endblock %}
