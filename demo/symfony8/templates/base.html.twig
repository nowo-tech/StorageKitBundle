<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Storage Kit Demo{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { padding-top: 56px; }
        .demo-images img { max-width: 100%; height: auto; border-radius: .25rem; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('demo_home') }}">Storage Kit Bundle Demo</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="{{ path('demo_notes') }}">Notes</a>
                <a class="nav-link" href="{{ path('nowo_storage_kit_settings') }}">Storage</a>
                <a class="nav-link" href="{{ path('nowo_storage_kit_move') }}">Move</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        {% block flashes %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
        {% endblock %}
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
