{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig).
    This file only declares the demo (nowo_ui_demo_platform). It is also the host layout of the Storage and Move pages
    and the Instance Settings sections (nowo_ui_kit.layouts). The demo users sign in with HTTP basic, so no auth link. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Storage Kit',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/StorageKitBundle',
    translation_domain: false,
    nav: [
        {label: 'Overview', route: 'demo_home', section: 'Demo'},
        {label: 'Notes', route: 'demo_notes', section: 'Demo'},
        {label: 'Storage', route: 'nowo_storage_kit_settings', section: 'Administration'},
        {label: 'Move', route: 'nowo_storage_kit_move', section: 'Administration'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Storage Kit Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit visible-when peer (provider-dependent fields): demo Stimulus app; a real host registers the peer in its own app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
{% endblock %}
