# -----------------------------------------------------------------------------
# Local environment (copy to .env — never commit .env, .env.local, or .env.dev)
# -----------------------------------------------------------------------------

# APP_ENV: Symfony environment (dev/test/prod). Demos use `dev` by default.
APP_ENV=dev

# APP_DEBUG: Verbose errors and Web Profiler (use `1` in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# APP_SECRET: Signing and CSRF; use a random value locally.
APP_SECRET=change_this_secret_key_to_a_random_value

# PORT: Host port published by docker-compose for this demo (must match your URL; bound to 127.0.0.1 only).
PORT=8213

###> doctrine/doctrine-bundle ###
# DATABASE_URL: MySQL service hostname is `db` (Compose), not localhost.
DATABASE_URL=mysql://storagekit:storagekit@db:3306/storage_kit_demo?serverVersion=8.0&charset=utf8mb4
###< doctrine/doctrine-bundle ###

###> demo object storage ###
# DEMO_S3_ENDPOINT: the RustFS service of this compose project (S3 API, Docker network only).
DEMO_S3_ENDPOINT=http://rustfs:9000
# DEMO_S3_ACCESS_KEY / DEMO_S3_SECRET_KEY: obviously fake development credentials of the demo RustFS (not secrets).
DEMO_S3_ACCESS_KEY=demo-access-key
DEMO_S3_SECRET_KEY=demo-secret-key-not-real
###< demo object storage ###

###> symfony/framework-bundle ###
# APP_SHARE_DIR: directory for data shared between deployments (Symfony 7.4+ share dir).
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/lock ###
# LOCK_DSN: store of the Lock component (upload rate limiter, sync); flock = local files.
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/routing ###
# DEFAULT_URI: Base URL for generating links in CLI; should match PORT above.
DEFAULT_URI=http://localhost:8213
###< symfony/routing ###
