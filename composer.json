{
    "name": "nowo-tech/storage-kit-bundle",
    "description": "S3-compatible object storage for Symfony: per-tenant buckets with encrypted credentials, image uploads for Markdown fields, reference-aware purge, bucket sync and an SSRF-guarded endpoint test.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "bundle",
        "storage",
        "s3",
        "flysystem",
        "uploads",
        "images",
        "markdown",
        "nowo",
        "frankenphp"
    ],
    "homepage": "https://github.com/nowo-tech/StorageKitBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Maintainer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "support": {
        "issues": "https://github.com/nowo-tech/StorageKitBundle/issues",
        "source": "https://github.com/nowo-tech/StorageKitBundle",
        "docs": "https://github.com/nowo-tech/StorageKitBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/StorageKitBundle/blob/main/docs/CHANGELOG.md"
    },
    "require": {
        "php": ">=8.2 <8.6",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\StorageKitBundle\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
